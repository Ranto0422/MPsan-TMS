# ── Docker Compose Environment ──
# Copy this file to .env and fill in the values.
# docker-compose reads this file automatically.

# PostgreSQL
POSTGRES_DB=mpsan_db
POSTGRES_USER=mpsan_user
POSTGRES_PASSWORD=changeme-strong-password

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS (comma-separated origins that the browser will call from)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Frontend build-time API URL
# Leave empty when Nginx proxies /api to backend on the same domain
VITE_API_URL=

# Port the frontend Nginx listens on (host side)
APP_PORT=80

# SMS Gateway
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1

# VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Redis (optional — enables cross-process WebSocket layer)
REDIS_URL=

# Storage ('local' or 's3')
STORAGE_BACKEND=local
